# Django Core
DJANGO_SECRET_KEY=change-me-please-generate-your-own-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (default SQLite para dev rápido)
# Para PostgreSQL: postgres://user:pass@localhost/erp_nexus
DATABASE_URL=sqlite:///./db.sqlite3

# Cache / Celery
REDIS_URL=redis://localhost:6379/0

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Facturación Ecuador
FACTURACION_EC_AMBIENTE=1  # 1=Pruebas, 2=Producción
FACTURACION_EC_AUTO_SEND=False
FACTURACION_EC_CERT_PATH=/path/to/certificado.p12
FACTURACION_EC_CERT_PASSWORD=

# OpenRouter (IA)
OPENROUTER_API_KEY=

# Logging
LOG_LEVEL=INFO
