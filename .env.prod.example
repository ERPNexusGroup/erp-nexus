# ERP Nexus — Variables de Entorno Producción (ejemplo)
# Copiar a .env.prod y ajustar valores. NO comitear .env.prod.

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=erp_nexus
POSTGRES_USER=erp
POSTGRES_PASSWORD=CambiarEstaContraseñaPorUnaSegura!

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=generar-con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ─── SRI Ecuador (Facturación Electrónica) ───────────────────────────────────
FACTURACION_CERT_PATH=/app/media/certs/cert.p12
FACTURACION_CERT_PASSWORD=
SRI_AMBIENTE=1  # 1=pruebas, 2=producción

# ─── GitHub Integration (Marketplace) ───────────────────────────────────────
GITHUB_TOKEN=
GITHUB_ORG=ERPNexusGroup

# ─── Gunicorn (opcional) ────────────────────────────────────────────────────
WEB_WORKERS=4
WEB_TIMEOUT=120
WEB_LOG_LEVEL=info

# ─── SSL / Domain (Nginx + Certbot) ───────────────────────────────────────────
DOMAIN=erp.example.com           # FQDN del dominio (ej: erp.tudominio.com)
SSL_EMAIL=admin@erp.example.com  # Email para notificaciones Let's Encrypt

# ─── Nginx (opcional) ─────────────────────────────────────────────────────────
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
